# Copy to .env and fill in. .env holds secrets: it is ignored by git and by the Docker build.

POSTGRES_DB=openportal
POSTGRES_USER=openportal
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Port on the host the portal listens on (put your TLS reverse proxy in front of it).
PORTAL_PORT=8080

# Shared key applications use to announce themselves (OpenPortal.Client). Leave empty to register them by hand.
PROVISIONING_KEY=

# First administrator, created by the migrate step when it does not exist yet. Turn it off again afterwards.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change-Me-Now-1!
BOOTSTRAP_ADMIN_DISPLAY_NAME=Portal Administrator

# Behind an https reverse proxy keep both true. For a quick local try over plain http on localhost set
# COOKIE_REQUIRE_SECURE=false and REVERSE_PROXY_ENABLED=false.
COOKIE_REQUIRE_SECURE=true
REVERSE_PROXY_ENABLED=true

AUDIT_RETENTION_DAYS=365
